# Database / Cache
# 로컬 5432가 이미 사용 중이면 POSTGRES_HOST_PORT와 DATABASE_URL의 포트를 함께 변경 (예: 5433)
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://unibot:unibot@localhost:5432/unibot
REDIS_URL=redis://localhost:6379/0

# JWT (운영에서는 반드시 랜덤 문자열로 교체: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Microsoft Entra ID (앱 등록 값)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# Frontend / Cookie (COOKIE_SECURE: 개발 false, 운영 true)
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# Seed admin (scripts/seed_admin.py 용)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Admin
